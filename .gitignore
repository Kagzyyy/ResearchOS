# Virtual environment — thousands of files, rebuildable from pyproject/requirements
.venv/

# Python bytecode cache
__pycache__/
*.pyc

# Downloaded datasets (BEIR/SciFact) — rebuildable, and large
datasets/

# Model weights, checkpoints, exported models — hundreds of MB each
models/
checkpoints/
*.bin
*.safetensors
*.onnx

# Cached indices and embeddings — rebuildable, slow but not source
cache/
indices/

# Secrets — ANTHROPIC_API_KEY lives here, never in git
.env

# Weights & Biases local run logs
wandb/

# SQLite citation-click log
*.db

# arXiv ingestion artefacts - rebuildable, and large
data/arxiv_papers.jsonl
data/arxiv_chunks.jsonl
# Bulk arXiv harvest and the corpus built from it - rebuildable, and large:
# scripts/harvest_arxiv_oai.py then scripts/build_corpus.py
data/arxiv_abstracts.jsonl
data/arxiv_abstracts.state.json
data/corpus_v3/

# Next.js frontend
web/node_modules/
web/.next/
web/out/
web/.env.local

# Uploaded PDFs and their extracted chunks
cache/uploads/

# Output of scripts/prepare_deploy.py
deploy/

# CRITIC-R1: local API-quota bookkeeping, per machine and per day
data/critic/.groq_budget*.json
