{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--prefix", "web"],
      "port": 3000
    },
    {
      "name": "api",
      "runtimeExecutable": ".venv/Scripts/python.exe",
