# Copy to .env and fill in. .env is gitignored - never commit real keys.

# ResearchOS-ML generation. Free key: https://console.groq.com/keys
# Without it, retrieval and reranking still work; you get ranked passages
# with no written answer.
GROQ_API_KEY=
# Parent project (SciFact) only. Not needed for ResearchOS-ML.
ANTHROPIC_API_KEY=

# Optional. When set, reranker training logs to Weights & Biases.
WANDB_API_KEY=
