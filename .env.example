# Copy to .env. Write it as UTF-8 - PowerShell's `>` produces UTF-16.
#   cmd:        echo GROQ_API_KEY=gsk_...> .env
#   PowerShell: Set-Content .env "GROQ_API_KEY=gsk_..." -Encoding utf8

# Required for written answers. Free key: https://console.groq.com/keys
# Without it, retrieval and reranking still work; you get ranked passages.
GROQ_API_KEY=

# --- deployment ---------------------------------------------------------
# Shared access token. When set, every endpoint except /health requires it.
# Deters drive-by abuse of your Groq quota. It ships to the browser in the
# frontend bundle, so it is a deterrent, not a secret.
RESEARCHOS_API_TOKEN=

# Comma-separated CORS origins. Defaults to localhost:3000.
RESEARCHOS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Requests per minute per client IP. Default 20.
RESEARCHOS_RATE_LIMIT=20

# Parent project (SciFact) only.
ANTHROPIC_API_KEY=
WANDB_API_KEY=
